@* @using System.Data
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Components.Widgets
@using JEO3.Diagrams
@using JEO3.Site.Components.Common
@using JEO3.Site.Components.Diagram
@using JEO3.Site.Components.Icons
@using Radzen

@namespace JEO3.Site.Dashboard
@inject IJSRuntime JS
@inject DialogService DialogService

<div class="dashboard-pane-container query-results-pane" @ref="queryResultsPaneDiv">
	<div class="dashboard-pane-titlebar-container dashboard-pane-query-results-container">
		<div class="dashboard-pane-titlebar" style="border-bottom:1px solid black">
			<div style="display: flex; align-items: center;">
				<span style="font-weight: bold;">Visualization</span>
			</div>
			<div class="dashboard-pane-titlebar-right-container" style="display: flex; align-items: center; gap: 6px;">

				<button type="button" class="dashboard-pane-titlebar-right-expand-button"
						@onclick="@SelectTop1000"
						style="height: 22px; width: 28px !important; border: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; color: var(--rz-white); background-color: var(--rz-text-selection-color); font-size:8pt;color:var(--rz-white); padding: 0;">
					<label style="font-size:16pt">🧐</label>
				</button>
				<RadzenDropDown TValue="SqlEditorTheme"
								Data="@Enum.GetValues(typeof(SqlEditorTheme))"
								@bind-Value="@W.UI.Appearance.DiagramTheme"
								Change="@(args => OnThemeChange((SqlEditorTheme)args))"
								Style="background-color:var(--jeo-primary);color:white;width:90px;height:30px;margin-top:-3px" />

				<!-- Retaining the RadzenSelectBar strictly for diagram type event triggers if needed elsewhere -->
				<RadzenStack Gap="0.1rem">
					<RadzenSelectBar @bind-Value="@W.UI.Settings.AutoGenerateDiagrams" class="diagramTypeSelector" TValue="bool" Size="ButtonSize.Small" @onchange="@(async (args) => { W.UI.Settings.AutoGenerateDiagrams = (bool)args.Value!; await OnDiagramSettingChanged.InvokeAsync(); })">
						<Items>
							<RadzenSelectBarItem Text="Database" Value="true" />
							<RadzenSelectBarItem Text="Jarvis" Value="false" class="pmb" />
						</Items>
					</RadzenSelectBar>
				</RadzenStack>

				<button type="button" class="dashboard-pane-titlebar-right-expand-button"
						@onclick="TogglePaneExpansionFullScreen"
						style="height: 22px; width: 22px; border: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; color: var(--rz-white); background-color: var(--jeo-gradient-rz); padding: 0;">
					@if (W.UI.Appearance.IsPaneFullScreenResults)
					{
						<IconMinimize/>
					}
					else
					{
						<IconMaximize/>
					}
				</button>
			</div>
		</div>
	</div>
	<div class="dashboard-pane-body-container-scroll" style="background-color:var(--rz-primary)">

		<RadzenTabs @bind-SelectedIndex="@this.W.UI.Tabs.SelectedIndex" RenderMode="TabRenderMode.Client" Style="height: calc(100% - 5px); overflow:hidden;background:var(--jeo-gradient-rz-light)">
			<Tabs>
				
				<RadzenTabsItem>
					<Template>
						<div style="display: flex; align-items: center;">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" style="width: 14px; height: 14px; fill: currentColor;">
								<path d="M416 208c0 45.9-25.1 86-62.4 107.1L400 416H342.4l-40-80H209.6l-40 80H112l46.4-100.9C121.1 294 96 253.9 96 208c0-88.4 71.6-160 160-160s160 71.6 160 160zM256 96c-61.9 0-112 50.1-112 112s50.1 112 112 112 112-50.1 112-112S317.9 96 256 96z" />
							</svg>
							<span>Execution Graph (Dual View)</span>
						</div>
					</Template>
					<ChildContent>

						<div class="dashboard-diagram-container" style="width: 100%; height: 100%; background-color:white; overflow: hidden; display: flex; flex-direction: row; position: relative;">

							<div class="diagram-config-sidebar"
								 style="width: @(W.UI.Appearance.IsSidebarExpandedDiagram ? "240px" : "0px");
								min-width: @(W.UI.Appearance.IsSidebarExpandedDiagram ? "240px" : "0px");
								height: 100%;
								background-color: var(--rz-panel-background-color, #f5f5f5);
								border-right: @(W.UI.Appearance.IsSidebarExpandedDiagram ? "1px solid var(--rz-border-color, #ccc)" : "none");
								transition: width 0.2s ease-in-out, min-width 0.2s ease-in-out;
								display: flex;
								flex-direction: column;
								overflow: hidden;
								position: relative;
								z-index: 10;">

								<div style="width: 240px; height: 100%; display: flex; flex-direction: column; box-sizing: border-box;">

									<div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px 4px 16px;">
										<span style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: var(--rz-text-color);">
											Engine Layout Configuration
										</span>
										<button type="button" @onclick="ToggleDiagramSidebar" title="Collapse Panel" class="sidebar-toggle-button-left collapsed">
											«
										</button>
									</div>

									<div style="padding: 12px 16px 16px 16px; display: flex; flex-direction: column; gap: 16px; overflow-y: auto; flex-grow: 1;">

										<div style="display: flex; flex-direction: column; gap: 6px;">
											<label style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: var(--rz-text-disabled-color, #888);;">
												Diagram Type
											</label>
											<RadzenDropDown TValue="JEO3.Diagrams.GraphLayoutShape"
															Data="@(Enum.GetValues(typeof(JEO3.Diagrams.GraphLayoutShape)))"
															@bind-Value="@W.UI.Diagram.LayoutShape"
															Change="@(async (val) => await OnDiagramLayoutShapeChanged(val))"
															Style="width: 100%; height: 32px;" />
										</div>

										<hr style="border: none; border-top: 1px solid var(--rz-border-color, #e0e0e0); margin: 4px 0;" />
										<div style="display: flex; flex-direction: column; gap: 6px;">
											<label style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: var(--rz-text-disabled-color, #888);;">
												Configuration Presets
											</label>
											<RadzenDropDown TValue="LayoutPresetType?"
															Data="@(Enum.GetValues(typeof(LayoutPresetType)).Cast<LayoutPresetType?>())"
															Placeholder="Select a configuration preset..."
															Change="@OnPresetChanged"
															Style="width: 100%; height: 32px;" />
										</div>

										<hr style="border: none; border-top: 1px solid var(--rz-border-color, #e0e0e0); margin: 4px 0;" />
										<div style="display: flex; flex-direction: column; gap: 4px;">
											<span style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: var(--rz-text-disabled-color, #888);; margin-bottom: 4px;">
												Tuning Constants
											</span>
											<ParameterEditor TargetParameters="@W.UI.Diagram.ActiveParameters" OnParameterChanged="DebouncedReRunLayout" />
										</div>
									</div>
								</div>
							</div>

							<!-- Canvas Container (Split 50/50 via Flexbox) -->
							<div style="flex-grow: 1; height: 100%; position: relative; background-color: white; display: flex; flex-direction: row;"
								 oncontextmenu="return false;"
								 onpointerup="if(event.button === 2) { this.releasePointerCapture(event.pointerId); }">

								@if (!W.UI.Appearance.IsSidebarExpandedDiagram)
								{
									<button type="button" @onclick="ToggleDiagramSidebar" title="Expand Configuration Options" class="sidebar-toggle-button-left expanded vertical-text-standard" style="z-index: 20;">
										⚙️
										<span>OPTIONS</span>
									</button>
								}

								<!-- Canvas 1: ActiveDiagram2 (Database Mode) -->
								<div style="flex: .5; height: 100%; position: relative; border-right: 2px solid var(--jeo-primary, #ccc);">
									@if (ActiveDiagram2 != null)
									{
										<style>
																				.cvDb .diagram-link-label .default-link-label {
																					font-size: 9pt;
																					font-weight: 400;
																					font-family: Consolas, Monaco, monospace;
																				}
										</style>
										<SilentErrorBoundary>
											<CascadingValue Value="@ActiveDiagram2">
												<DiagramCanvas Class="cvDb">
													<Widgets>
														<GridWidget Size="10"
																	Mode="GridMode.Point"
																	BackgroundColor="@DiagramBackgroundColor" />
														<NavigatorWidget Width="140" Height="90" Style="position: absolute; bottom: 10px; right: 10px; border: 1px solid var(--jeo-gradient-rz); background:grey;" />
													</Widgets>
												</DiagramCanvas>
											</CascadingValue>
										</SilentErrorBoundary>
									}
									else
									{
										<div style="padding: 1rem; color: #888;">ActiveDiagram2 rendering pending...</div>
									}
								</div>
								<!-- Canvas 2: ActiveDiagram (Jarvis Mode) -->
								<div style="flex: .5; height: 100%; position: relative;">
									@if (ActiveDiagram != null)
									{
										<style>
																				.cbJarvis .diagram-link-label .default-link-label {
																					font-size: 3.75pt;
																					font-weight: 400;
																					font-family: Consolas, Monaco, monospace;
																				}
										</style>
										<SilentErrorBoundary>
											<CascadingValue Value="@ActiveDiagram">
												<DiagramCanvas Class="cbJarvis">
													<Widgets>
														<GridWidget Size="10"
																	Mode="GridMode.Point"
																	BackgroundColor="@DiagramBackgroundColor" />
														<NavigatorWidget Width="140" Height="90" Style="position: absolute; bottom: 10px; right: 10px; border: 1px solid var(--jeo-gradient-rz); background:grey;" />
													</Widgets>
												</DiagramCanvas>
											</CascadingValue>
										</SilentErrorBoundary>
									}
									else
									{
										<div style="padding: 1rem; color: #888;">ActiveDiagram rendering pending...</div>
									}
								</div>
							</div>
						</div>
					</ChildContent>
				</RadzenTabsItem>
			</Tabs>
		</RadzenTabs>

	</div>
</div> *@