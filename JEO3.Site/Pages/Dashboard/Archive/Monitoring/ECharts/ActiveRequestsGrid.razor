@using JEO3.Monitor
@inherits MonitorBase
@namespace JEO3.Site.Components.ECharts

@if (ActiveRequests is not null && ActiveRequests.Count > 0)
{
	<div class="dashboard-pane-container" style="height:@(Height); width:@(Width)">
		<div class="dashboard-pane-body-container-scroll">
			<div class="monitor-section">
				<div class="monitor-section-title">
					🚨 ACTIVE REQUESTS

					<span class="monitor-section-badge">
						@ActiveRequests.Count
					</span>

					@if (ActiveRequests.Any(r => r.IsBlocked))
					{
						<span class="monitor-section-badge monitor-badge-warn">
							@ActiveRequests.Count(r => r.IsBlocked) BLOCKED
						</span>
					}
				</div>

				<RadzenDataGrid Data="@OrderedRequests"
								TItem="ActiveRequestRow"
								AllowSorting="true"
								AllowFiltering="true"
								AllowColumnResize="true"
								AllowColumnReorder="true"
								Density="Density.Compact"
								AllowAlternatingRows="true"
								AllowVirtualization="true"
								Style="width: 100vw;">

					<Columns>
						<RadzenDataGridColumn TItem="ActiveRequestRow"
											  Property="@nameof(ActiveRequestRow.SessionId)"
											  Title="SPID"
											  Width="80px" />

						<RadzenDataGridColumn TItem="ActiveRequestRow"
											  Property="@nameof(ActiveRequestRow.BlockingSessionId)"
											  Title="Blocked By"
											  Width="100px">
							<Template Context="r">
								@(r.BlockingSessionId > 0
									? r.BlockingSessionId.ToString()
									: "—")
							</Template>
						</RadzenDataGridColumn>

						<RadzenDataGridColumn TItem="ActiveRequestRow"
											  Property="@nameof(ActiveRequestRow.Status)"
											  Title="Status"
											  Width="120px" />

						<RadzenDataGridColumn TItem="ActiveRequestRow"
											  Property="@nameof(ActiveRequestRow.WaitTimeSec)"
											  Title="Wait"
											  TextAlign="TextAlign.Right"
											  Width="100px"
											  FormatString="{0:N1}s" />

						<RadzenDataGridColumn TItem="ActiveRequestRow"
											  Property="@nameof(ActiveRequestRow.CpuTimeMs)"
											  Title="CPU"
											  TextAlign="TextAlign.Right"
											  Width="110px"
											  FormatString="{0:N0}" />

						<RadzenDataGridColumn TItem="ActiveRequestRow"
											  Property="@nameof(ActiveRequestRow.LogicalReads)"
											  Title="Reads"
											  TextAlign="TextAlign.Right"
											  Width="120px"
											  FormatString="{0:N0}" />

						<RadzenDataGridColumn TItem="ActiveRequestRow"
											  Property="@nameof(ActiveRequestRow.Writes)"
											  Title="Writes"
											  TextAlign="TextAlign.Right"
											  Width="110px"
											  FormatString="{0:N0}" />

						<RadzenDataGridColumn TItem="ActiveRequestRow"
											  Property="@nameof(ActiveRequestRow.OpenTxnCount)"
											  Title="Txns"
											  TextAlign="TextAlign.Right"
											  Width="80px" />

						<RadzenDataGridColumn TItem="ActiveRequestRow"
											  Property="@nameof(ActiveRequestRow.DatabaseName)"
											  Title="Database"
											  Width="160px" />

						<RadzenDataGridColumn TItem="ActiveRequestRow"
											  Property="@nameof(ActiveRequestRow.LoginName)"
											  Title="Login"
											  Width="180px" />

						<RadzenDataGridColumn TItem="ActiveRequestRow"
											  Property="@nameof(ActiveRequestRow.Command)"
											  Title="Command"
											  Width="580px" />
					</Columns>
				</RadzenDataGrid>
			</div>
		</div>
	</div>
}

@code {
	private IEnumerable<ActiveRequestRow> OrderedRequests =>
		ActiveRequests.OrderByDescending(x => x.WaitTimeSec);

	protected override async Task RenderInitialAsync(MonitorSnapshot initial)
	{
		await InvokeAsync(StateHasChanged);
	}

	protected override async Task AppendDeltasAsync(MonitorDeltaResponse delta)
	{
		if (delta.ActiveRequests != null)
		{
			await InvokeAsync(StateHasChanged);
		}
	}
}