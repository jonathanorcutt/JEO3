@code
{

	#region Traffic Stress
	private async Task GenerateTraffic()
	{
		if (W.Observation.Traffic.IsRunning) { return; }
		W.Observation.Traffic.IsRunning = true;

		try
		{
			const int upLimit = 3;
			const int downLimit = 3;
			int idx = 0;
			Parallel.ForEach(W.Context.Tables, new ParallelOptions() { MaxDegreeOfParallelism = 2 }, async (tbl) =>
			{
				idx++;
				int pctCompleted = (int)(((double)(idx) / (double)(W.Context.Tables.Count)) * 100);
				W.Observation.Traffic.CurrentTable = tbl.SchemaName + "." + tbl.Name;
				W.Observation.Traffic.PercentCompleted = pctCompleted + "%";
				W.NotifyDashboardStateChanged();

				for (var up = 1; up < upLimit; up++)
				{
					for (var down = 1; down < downLimit; down++)
					{
						var options = W.UI.ERSettings.ToGenerationOptions(new List<GraphRelationConstraint>(), GenerationMethod.PlanDrivenExecution);
						options.Traversal.LevelsUp = up;
						options.Traversal.LevelsDown = down;
						options.Retrieval.RootSelectPolicy = TableSelectPolicy.AllColumns;
						options.Retrieval.JoinSelectPolicy = TableSelectPolicy.AllColumns;
						options.Traversal.PreventRootTypeRecursion = true;
						pctCompleted = (int)(((double)(up * down) / (double)(upLimit * downLimit)) * 100);
						W.Observation.Traffic.PercentCompleted = pctCompleted + "%";
						await InvokeAsync(StateHasChanged);

						Parallel.ForEach(tbl.Indexes, new ParallelOptions() { MaxDegreeOfParallelism = 2 }, (index) =>
						{
							string script = $"ALTER INDEX {index.Name} ON {tbl.SchemaName}.{tbl.Name} REBUILD WITH (ONLINE = ON);";
							W.Context.Provider.ExecuteNonQuery(script);
						});

						var gen = new PlanDrivenQueryGenerator();
						var result = gen.Generate(tbl, options);
						var dt = await ConnectionService.Execute(result.GeneratedQuery);
						if (dt == null)
						{
							await Task.Delay(1250);
						}
					}
				}
			});
		}
		catch (Exception ex)
		{
			ExceptionUtility.LogException(ex);
		}
		finally
		{
			W.Observation.Traffic.IsRunning = false;
			await InvokeAsync(StateHasChanged);
		}
	}
	#endregion

	private ChartThemeType _selectedTheme = ChartThemeType.Default;

	private readonly HashSet<string> _expandedSqlHandleHexs = new();
	private TopExpensiveQueriesGrid gridTopExpensiveQueries;

	private StandaloneCodeEditor queryEditorTopExpensiveQueries;
	private StandaloneEditorConstructionOptions EditorOptionsTopExpensiveQueries(StandaloneCodeEditor editor)
	{
		var br = "\r\n";
		var defaultText = br + br + br + br + br + "\t// Click on a query to get started :) ...  " + br + br + br + br + br
			+ string.Join(br, A5C11.GetAsciiArt("JEO3.com", false).Split('\n').Select(v => " " + v.Replace("\r", "").Replace(" ", " ")));
		return new StandaloneEditorConstructionOptions
		{
			AutomaticLayout = true,
			Value = defaultText,
			Minimap = new EditorMinimapOptions { Enabled = false },
			FontSize = 14,
			FontFamily = "Consolas, Cascadia Mono, Cascadia Code, Courier New, monospace",
			Language = "sql",
			Theme = "vs",
			//LineNumbers = "off",
			//RenderLineHighlight = "none",
			Guides = new GuidesOptions() { Indentation = false },
			MouseWheelZoom = true,
			// Block the editor from downloading validation background workers for other languages
			// --- flat 3.4.0 settings to suppress background workers ---
			CodeLens = false,
			SnippetSuggestions = "none",
			QuickSuggestions = new QuickSuggestionsOptions { Other = "false", Comments = "false", Strings = "false" }
		};
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		_selectedTheme = ChartThemeType.Default;
	}

	private async Task OnThemeChanged()
	{
		StateHasChanged();
	}

	private void OnEditorInitializedTopExpensiveQueries() { }

	private void OnEditorContentChangedTopExpensiveQueries() { }

	private async Task SelectedQueryChanged(TopExpensiveQueryRow qry)
	{
		if (queryEditorTopExpensiveQueries == null) { return; }
		await queryEditorTopExpensiveQueries.SetValue(qry?.QueryText ?? string.Empty);
	}

	private void OnTopExpensiveQueryRowExpand(TopExpensiveQueryRow blocker)
	{
		_expandedSqlHandleHexs.Add(blocker.SqlHandleHex);
	}

	private void OnTopExpensiveQueryRowCollapse(TopExpensiveQueryRow blocker)
	{
		_expandedSqlHandleHexs.Remove(blocker.SqlHandleHex);
	}

	private async Task RestoreExpandedTopExpensiveQueryRowsAsync()
	{
	}
}