@using JEO3.Monitor.ECharts
@using JEO3.Schema
@using JEO3.Site.Components.Charting
@using JEO3.Site.Components.Icons
@using JEO3.Site.Dashboard

@namespace JEO3.Site.Components.TileLayout

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mb-1 rz-mt-1">
	<RadzenSwitch @bind-Value=@editMode Name="EditMode" />
	<RadzenLabel Text="Edit mode" Component="EditMode" />

	<RadzenSwitch @bind-Value=@showGrid Name="ShowGrid" />
	<RadzenLabel Text="Show grid" Component="ShowGrid" />

    <VSIcon Width="22" Height="22" Name="file_type_opencl" Type="VSIconType.VSCode" Class="fa-mr7 fa-m;-15" /> 
    <label for="preventRootTypeRecursion" class="sidebar-config-checkbox-label fa-mr-15">Dashboard saves automatically</label>
</RadzenStack>

<div class="dashboard-pane-container query-results-pane">
	<div class="dashboard-pane-body-container-scroll">
        <div class="sample-tile-layout">
			<TileLayoutManager DefaultTiles="@DashboardLayout" StorageKey="user_homepage_grid" EditMode="@editMode" ShowGrid="@showGrid" />
		</div>
	</div>
</div>

