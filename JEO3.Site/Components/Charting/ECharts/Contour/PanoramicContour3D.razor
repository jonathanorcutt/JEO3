@inject IJSRuntime JSRuntime
@implements IAsyncDisposable
@namespace JEO3.Site.Components.Charting
@typeparam TRow

<div id="@_containerId" class="schema-contour-3d" style="width: @(Width); height: @(Height); background-color: #0a0c10;"></div>

@code {
    [Parameter] public IEnumerable<TRow> Rows { get; set; } = [];
    [Parameter] public IReadOnlyList<string> Columns { get; set; } = [];
    [Parameter] public Func<TRow, string> RowLabelSelector { get; set; } = _ => string.Empty;
    [Parameter] public Func<TRow, string, double> CellSelector { get; set; } = (_, _) => 0;
    
    [Parameter] public string Width { get; set; } = "100vw";
    [Parameter] public string Height { get; set; } = "100%";
    [Parameter] public string Title { get; set; } = "Schema Heat Map";
    [Parameter] public string XAxisTitle { get; set; } = "Metric";
    [Parameter] public string YAxisTitle { get; set; } = "Table";
    [Parameter] public string IntensityLabel { get; set; } = "Complexity";

    private readonly string _containerId = $"chart-3d-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private bool _jsAvailable = false;
    private bool _isDisposed = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsAvailable = true;
            // Lock the runtime scripts into a cleanly separated context thread
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/echarts/charts3d.js");
            await Build3DChartAsync();
        }
    }

    private async Task Build3DChartAsync()
    {
        if (_isDisposed || !_jsAvailable || _module == null) return;

        var rowsList = Rows?.ToList() ?? [];
        if (rowsList.Count == 0 || Columns.Count == 0 || _module == null) return;

        var chartData = new List<double[]>();
        for (var y = 0; y < rowsList.Count; y++)
        {
            var row = rowsList[y];
            for (var x = 0; x < Columns.Count; x++)
            {
                var intensity = Math.Clamp(CellSelector(row, Columns[x]), 0.0, 1.0);
                chartData.Add(new double[] { x, y, intensity });
            }
        }

        var xAxisCategories = Columns.Select(c => c.ToString()).ToArray();
        var yAxisCategories = rowsList.Select(r => RowLabelSelector(r)).ToArray();

        try
        {
            // Execute out of the isolated module footprint instead of the dirty global window thread
            await _module.InvokeVoidAsync(
                "renderPanoramic3DChart",
                _containerId,
                Title,
                XAxisTitle,
                YAxisTitle,
                IntensityLabel,
                xAxisCategories,
                yAxisCategories,
                chartData
            );
        }
        catch
        {
            // Fail-safe block
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module != null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch { }
        }
        _isDisposed = true;
    }
}