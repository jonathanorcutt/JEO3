@using Radzen
@using Radzen.Blazor

@namespace JEO3.Site.Components.Charting

<div class="viz-wrap" style="@Style">
    <RadzenChart Animate="true" Style="width:100%; height:100%;">

        <RadzenHorizontalWaterfallSeries TItem="WaterfallStep"
                                         Data="@Steps"
                                         CategoryProperty="Label"
                                         ValueProperty="Value"
                                         Title="@Title" />

        <RadzenCategoryAxis>
            <RadzenAxisTitle Text="@CategoryAxisTitle" />
        </RadzenCategoryAxis>

        <RadzenValueAxis>
            <RadzenAxisTitle Text="@ValueAxisTitle" />
        </RadzenValueAxis>

    </RadzenChart>
</div>

@code {
    // Caller supplies ordered steps: positive values add, negative values subtract,
    // last step is conventionally the running total. e.g. per-metric contribution
    // to a table's overall complexity score.
    [Parameter] public IReadOnlyList<WaterfallStep> Steps { get; set; } = [];
    [Parameter] public string Title { get; set; } = "Composition";
    [Parameter] public string CategoryAxisTitle { get; set; } = "Component";
    [Parameter] public string ValueAxisTitle { get; set; } = "Value";
    [Parameter] public string Style { get; set; } = "width:100%; height:100%;";

    public sealed class WaterfallStep
    {
        public string Label { get; init; } = string.Empty;
        public double Value { get; init; }
    }
}
