@using Radzen
@using Radzen.Blazor

@namespace JEO3.Site.Components.Charting
@typeparam TItem

<div class="viz-wrap" style="@Style">
    <RadzenChart Animate="true" Style="width:100%; height:100%;">

        @foreach (var series in SeriesNames)
        {
            <RadzenStackedColumnSeries TItem="StackPoint"
                                       Data="@RowsFor(series)"
                                       CategoryProperty="Category"
                                       ValueProperty="Value"
                                       Title="@series" />
        }

        <RadzenCategoryAxis>
            <RadzenAxisTitle Text="@CategoryAxisTitle" />
        </RadzenCategoryAxis>

        <RadzenValueAxis>
            <RadzenAxisTitle Text="@ValueAxisTitle" />
        </RadzenValueAxis>

        <RadzenLegend Position="LegendPosition.Bottom" />

    </RadzenChart>
</div>

@code {
    [Parameter] public IEnumerable<TItem> Items { get; set; } = [];
    [Parameter] public Func<TItem, string> CategorySelector { get; set; } = _ => string.Empty;
    [Parameter] public IReadOnlyList<string> SeriesNames { get; set; } = [];
    [Parameter] public Func<TItem, string, double> ValueSelector { get; set; } = (_, _) => 0;
    [Parameter] public string CategoryAxisTitle { get; set; } = "Table";
    [Parameter] public string ValueAxisTitle { get; set; } = "Count";
    [Parameter] public string Style { get; set; } = "width:100%;height:100%;";

    private sealed class StackPoint
    {
        public string Category { get; init; } = string.Empty;
        public double Value { get; init; }
    }

    private List<StackPoint> RowsFor(string series)
    {
        var items = Items?.ToList() ?? [];
        return items.Select(i => new StackPoint
        {
            Category = CategorySelector(i),
            Value = ValueSelector(i, series)
        }).ToList();
    }
}
