@using Radzen.Blazor

@namespace JEO3.Site.Components.Charting

<div class="viz-wrap" style="@Style">
    <RadzenChart Animate="true" Style="width:100%; height:100%;">

        <RadzenFunnelSeries TItem="FunnelStage"
                            Data="@Stages"
                            CategoryProperty="Label"
                            ValueProperty="Count"
                            Title="@Title" />

        <RadzenLegend Position="LegendPosition.Right" />

    </RadzenChart>
</div>

@code {
    // Caller builds the ordered stage list directly — each stage is a count that
    // should be <= the previous stage's count for the funnel to read correctly.
    // e.g. All Tables -> Has Primary Key -> Has Foreign Key -> Has Index -> Has Trigger

    [Parameter] public IReadOnlyList<FunnelStage> Stages { get; set; } = [];
    [Parameter] public string Title { get; set; } = "Schema Completeness";
    [Parameter] public string Style { get; set; } = "width:100%; height:100%;";

    public sealed class FunnelStage
    {
        public string Label { get; init; } = string.Empty;
        public double Count { get; init; }
    }
}
