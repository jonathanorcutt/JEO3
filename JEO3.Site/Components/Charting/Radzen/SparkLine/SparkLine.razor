@namespace JEO3.Site.Components.Charting


<div class="sparkline-container" style="width: @Width; height: @Height;">
    @if (Points != null && Points.Count > 1)
    {
        <svg width="100%" height="100%" viewBox="0 0 @SvgWidth @SvgHeight" preserveAspectRatio="none">
            <polyline fill="none"
                      stroke="@Color"
                      stroke-width="@StrokeWidth"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      points="@GetSvgPoints()" />
        </svg>
        <span class="fw-bold rz-mr-2">@WaitTimeLabelText</span>
    }
</div>

@code {
    [Parameter] public string WaitTimeLabelText { get; set; } = string.Empty;

    [Parameter] public List<double> Points { get; set; } = new();
    [Parameter] public string Color { get; set; } = "#00ff66"; // Match green theme
    [Parameter] public string Width { get; set; } = "180px";
    [Parameter] public string Height { get; set; } = "50px";
    [Parameter] public double StrokeWidth { get; set; } = 1;

    private const double SvgWidth = 100;
    private const double SvgHeight = 50;

    private string GetSvgPoints()
    {
        if (Points == null || Points.Count < 2) return string.Empty;

        double min = Points.Min();
        double max = Points.Max();
        double range = max - min;

        // Prevent division by zero if all values are identical
        if (Math.Abs(range) < 0.0001) range = 1;

        var sb = new System.Text.StringBuilder();
        double stepX = SvgWidth / (Points.Count - 1);

        for (int i = 0; i < Points.Count; i++)
        {
            double x = i * stepX;
            // Invert Y axis because SVG (0,0) starts at top-left
            double normalizedY = (Points[i] - min) / range;
            double y = SvgHeight - (normalizedY * (SvgHeight - 4)) - 2;

            sb.Append($"{x.ToString(System.Globalization.CultureInfo.InvariantCulture)},{y.ToString(System.Globalization.CultureInfo.InvariantCulture)} ");
        }

        return sb.ToString().TrimEnd();
    }
}