@using Radzen
@using Radzen.Blazor

@namespace JEO3.Site.Components.Charting
@typeparam TItem

<div class="viz-wrap" style="@Style">
    <RadzenChart Animate="true" Style="width:100%; height:100%;">

        <RadzenScatterSeries TItem="ScatterPoint"
                             Data="@_points"
                             CategoryProperty="X"
                             ValueProperty="Y"
                             Title="@Title" />

        <RadzenCategoryAxis>
            <RadzenAxisTitle Text="@XAxisTitle" />
        </RadzenCategoryAxis>

        <RadzenValueAxis>
            <RadzenAxisTitle Text="@YAxisTitle" />
        </RadzenValueAxis>

    </RadzenChart>
</div>

@code {
    [Parameter] public IEnumerable<TItem> Items { get; set; } = [];
    [Parameter] public Func<TItem, double> XSelector { get; set; } = _ => 0;
    [Parameter] public Func<TItem, double> YSelector { get; set; } = _ => 0;
    [Parameter] public Func<TItem, string> LabelSelector { get; set; } = _ => string.Empty;
    [Parameter] public string Title { get; set; } = "Correlation";
    [Parameter] public string XAxisTitle { get; set; } = "X";
    [Parameter] public string YAxisTitle { get; set; } = "Y";
    [Parameter] public string Style { get; set; } = "width:100%;height:100%;";

    private List<ScatterPoint> _points = [];

    protected override void OnParametersSet() => _points = BuildPoints();

    private sealed class ScatterPoint
    {
        public double X { get; init; }
        public double Y { get; init; }
        public string Label { get; init; } = string.Empty;
    }

    private List<ScatterPoint> BuildPoints()
    {
        var items = Items?.ToList() ?? [];
        return items.Select(i => new ScatterPoint
        {
            X = XSelector(i),
            Y = YSelector(i),
            Label = LabelSelector(i)
        }).ToList();
    }
}
