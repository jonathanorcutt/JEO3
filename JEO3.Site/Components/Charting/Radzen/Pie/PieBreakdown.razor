@using Radzen
@using Radzen.Blazor

@namespace JEO3.Site.Components.Charting
@typeparam TItem

<div class="viz-wrap" style="@Style">
    <RadzenChart Animate="true" Style="width:100%; height:100%; ">

        @if (Donut)
        {
            <RadzenDonutSeries TItem="SlicePoint"  Data="@_slices" CategoryProperty="Label" ValueProperty="Count" Title="@Title" />
        }
        else
        {
            <RadzenPieSeries TItem="SlicePoint" Data="@_slices"  CategoryProperty="Label" ValueProperty="Count"  Title="@Title" />
        }

        <RadzenLegend Position="LegendPosition.Right" />

    </RadzenChart>
</div>

@code {
    [Parameter] public IEnumerable<TItem> Items { get; set; } = [];
    [Parameter] public Func<TItem, string> GroupSelector { get; set; } = _ => "Unknown";
    [Parameter] public string Title { get; set; } = "Distribution";
    [Parameter] public bool Donut { get; set; } = true;
    [Parameter] public string Style { get; set; } = "width:100%;height:100%;";

    private List<SlicePoint> _slices = [];

    protected override void OnParametersSet() => _slices = BuildSlices();

    private sealed class SlicePoint
    {
        public string Label { get; init; } = string.Empty;
        public double Count { get; init; }
    }

    private List<SlicePoint> BuildSlices()
    {
        var items = Items?.ToList() ?? [];
        if (items.Count == 0) return [];

        return items
            .GroupBy(GroupSelector)
            .Select(g => new SlicePoint { Label = g.Key, Count = g.Count() })
            .OrderByDescending(s => s.Count)
            .ToList();
    }
}
