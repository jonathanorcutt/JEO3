@using Radzen
@using Radzen.Blazor

@namespace JEO3.Site.Components.Charting
@typeparam TItem

@* No real timestamp on schema objects, so this fakes a "trend" by walking items
   in OrderSelector order and plotting a running cumulative total. Useful for
   showing schema growth/composition shape, not an actual time series. *@

<div class="viz-wrap" style="@Style">
    <RadzenChart Animate="true" Style="width:100%; height:100%;">

        <RadzenLineSeries TItem="TrendPoint"
                          Data="@_points"
                          CategoryProperty="Label"
                          ValueProperty="CumulativeValue"
                          Title="@SeriesTitle"
                          Smooth="true" />

        <RadzenCategoryAxis>
            <RadzenAxisTitle Text="@CategoryAxisTitle" />
        </RadzenCategoryAxis>

        <RadzenValueAxis>
            <RadzenAxisTitle Text="@ValueAxisTitle" />
        </RadzenValueAxis>

        <RadzenLegend Position="LegendPosition.Bottom" />

    </RadzenChart>
</div>

@code {
    [Parameter] public IEnumerable<TItem> Items { get; set; } = [];
    [Parameter] public Func<TItem, string> LabelSelector { get; set; } = _ => string.Empty;
    [Parameter] public Func<TItem, double> ValueSelector { get; set; } = _ => 0;
    [Parameter] public Func<TItem, IComparable> OrderSelector { get; set; } = _ => 0;
    [Parameter] public string SeriesTitle { get; set; } = "Cumulative";
    [Parameter] public string CategoryAxisTitle { get; set; } = "Table";
    [Parameter] public string ValueAxisTitle { get; set; } = "Running Total";
    [Parameter] public string Style { get; set; } = "width:100%; height:100%;";

    private List<TrendPoint> _points = [];

    protected override void OnParametersSet() => _points = BuildPoints();

    private sealed class TrendPoint
    {
        public string Label { get; init; } = string.Empty;
        public double CumulativeValue { get; init; }
    }

    private List<TrendPoint> BuildPoints()
    {
        var items = Items?.ToList() ?? [];
        if (items.Count == 0) return [];

        var ordered = items.OrderBy(OrderSelector).ToList();
        var running = 0d;
        var result = new List<TrendPoint>();

        foreach (var item in ordered)
        {
            running += ValueSelector(item);
            result.Add(new TrendPoint { Label = LabelSelector(item), CumulativeValue = running });
        }

        return result;
    }
}
