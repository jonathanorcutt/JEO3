@namespace JEO3.Site.Dashboard
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div style="position:absolute;top:0px;left:0px;width:100vw;height:100vh;overflow:hidden;">
    <!-- Blazor preserves this container untouched due to @key -->
    <div id="videoContainer" @key='"dont-touch-me-blazor"'></div>
</div>

@code {
    private const string _mp4 = "mp4";
    private const string _webm = "webm";
    public enum VideoFileExtension
    {
        mp4,
        webm
    }

    [Parameter] public VideoFileExtension ExtentionType { get; set; } = VideoFileExtension.mp4;
    [Parameter] public string FileDirectoryPathRelative { get; set; } = $"../assets/";
    [Parameter] public string FileNameWithoutExtension { get; set; } = $"matrix";
    [Parameter] public int MarginTop { get; set; } = 0;

    private string FilePathWithExtension
    {
        get
        {
            FileDirectoryPathRelative += FileDirectoryPathRelative.EndsWith("/") ? string.Empty : "/";
            return FileDirectoryPathRelative + FileNameWithoutExtension.TrimStart('/').TrimEnd('.') + "." + ExtentionType.ToString(); ;
        }
    }

    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load the JS module dynamically from wwwroot
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "../js/video/videoPlayer.js");

            await _module.InvokeVoidAsync("initVideo", "videoContainer", FilePathWithExtension, ExtentionType, MarginTop);
        }
    }

    public async Task ChangeVideo(string newUrl)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("changeVideo", newUrl);
        }
    }

    // Clean up the module reference when the component is destroyed
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Safe to ignore during circuit disconnection in Blazor Server
            }
        }
    }
}