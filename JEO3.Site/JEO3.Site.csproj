		<None Remove="Pages\Dashboard\Archive\Monitoring\**" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Pages\Dashboard\Archive\Landing.razor.cs" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="Pages\Dashboard\Archive\Landing.razor" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Pages\Dashboard\Archive\Landing.razor.css" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Archive\landing-layout.css" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BlazorMonaco" />
		<PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" />
		<PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
		<PackageReference Include="PanoramicData.ECharts" />
		<PackageReference Include="Radzen.Blazor" />
		<PackageReference Include="System.Configuration.ConfigurationManager" />
		<PackageReference Include="Z.Blazor.Diagrams" />
		<PackageReference Include="Z.Blazor.Diagrams.Core" />
		<PackageReference Include="System.Management" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\JEO3.Code\JEO3.Code.csproj" />
		<ProjectReference Include="..\JEO3.Diagrams\JEO3.Diagrams.csproj" />
		<ProjectReference Include="..\JEO3.Engine\JEO3.Engine.csproj" />
		<ProjectReference Include="..\JEO3.Monitor.Charts\JEO3.Monitor.Charts.csproj" />
		<ProjectReference Include="..\JEO3.Monitor\JEO3.Monitor.csproj" />
	</ItemGroup>

</Project>
