<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>JEO3.Site</RootNamespace>
		<AssemblyName>JEO3.Site</AssemblyName>
		<InvariantGlobalization>false</InvariantGlobalization>
		<UserSecretsId>JEO3.Site</UserSecretsId>
		<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Pages\Dashboard\Archive\Monitoring\**" />
		<Content Remove="Pages\Dashboard\Archive\Monitoring\**" />
